#!/bin/bash
# 步驟 11：部署前先用 docker run 在本機測試容器
source "$(dirname "$0")/lib"
docker rm -f t-a t-b >/dev/null 2>&1 || true
step "docker run server-a / server-b"
docker run -d --name t-a -p 5000:5000 hw1-server-a:v1
docker run -d --name t-b -p 5001:5001 hw1-server-b:v1
sleep 3; docker ps --filter name=t-
step "Test with curl"
curl -s "localhost:5000/calc?a=12&b=5&op=mul"; echo
curl -s "localhost:5001/text?s=hello+k8s+hello"; echo
docker rm -f t-a t-b >/dev/null
echo -e "\e[1;32m[DONE] h02-dockertest\e[0m"
