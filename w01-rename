#!/bin/bash
# 複製出來的 work 節點：改主機名稱、重新產生 machine-id（避免拿到跟 master 一樣的 DHCP IP）
source "$(dirname "$0")/lib"
NEW=${1:-work}
step "Set hostname to $NEW"
sudo hostnamectl set-hostname "$NEW"
sudo sed -i -E "s/^(127\.0\.1\.1\s+).*/\1$NEW/" /etc/hosts
step "Regenerate machine-id"
sudo rm -f /etc/machine-id /var/lib/dbus/machine-id
sudo systemd-machine-id-setup
step "Rebooting"
sleep 3
sudo reboot
