#!/bin/bash
# 步驟 13：測試部署結果
source "$(dirname "$0")/lib"
MASTER_IP=$HOSTIP
step "kubectl get pods -o wide（Pod 分佈在哪些節點）"
kubectl get pods -o wide
step "C 電腦 (NodePort 30002) → 呼叫 A 電腦做運算"
curl -s "http://$MASTER_IP:30002/calc?a=12&b=5&op=pow" | grep -E "<th>|<td>" | sed -E 's/<[^>]+>/ /g' | tr -s ' '
step "C 電腦 → 呼叫 B 電腦做文字分析"
curl -s "http://$MASTER_IP:30002/text?s=Kubernetes+runs+containers" | grep -E "<th>|<td>" | sed -E 's/<[^>]+>/ /g' | tr -s ' '
step "多次呼叫 A 的 Service，觀察負載平衡到不同 Pod"
for i in 1 2 3 4 5 6; do
  kubectl exec deploy/server-c -- python -c "import requests;print(requests.get('http://server-a-service:5000/prime?n=97').text)"
done
echo -e "\e[1;32m[完成] h04-test\e[0m"
