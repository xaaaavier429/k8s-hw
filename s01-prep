#!/bin/bash
# 步驟 1：VM 前置設定（套件來源、swap、核心模組、網路參數）
source "$(dirname "$0")/lib"
step "Host info"
hostnamectl | grep -E "Static hostname|Operating System|Kernel|Architecture"
echo "Host-only iface: $HOSTIF  IP: $HOSTIP"

step "Ubuntu 24.10 is EOL -> switch apt sources to old-releases"
if ! curl -sfI http://ports.ubuntu.com/ubuntu-ports/dists/oracular/Release >/dev/null; then
  sudo sed -i -E 's#https?://(ports\.ubuntu\.com/ubuntu-ports|[a-z.]*archive\.ubuntu\.com/ubuntu|security\.ubuntu\.com/ubuntu)/?#http://old-releases.ubuntu.com/ubuntu/#g' \
    /etc/apt/sources.list.d/ubuntu.sources /etc/apt/sources.list 2>/dev/null || true
fi
grep -h "^URIs" /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null | sort -u

step "apt update and install basic tools"
sudo apt-get update -q
sudo apt-get install -y -q apt-transport-https ca-certificates curl gpg git net-tools

step "Disable swap (required by kubelet)"
sudo swapoff -a
sudo sed -i -E '/\sswap\s/ s/^#?/#/' /etc/fstab
free -h | grep -i swap

step "Load overlay and br_netfilter kernel modules"
cat <<EOT | sudo tee /etc/modules-load.d/k8s.conf
overlay
br_netfilter
EOT
sudo modprobe overlay
sudo modprobe br_netfilter
lsmod | grep -E "overlay|br_netfilter"

step "Enable IPv4 forwarding and bridged traffic for iptables"
cat <<EOT | sudo tee /etc/sysctl.d/k8s.conf
net.bridge.bridge-nf-call-iptables  = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward                 = 1
EOT
sudo sysctl --system >/dev/null
sysctl net.bridge.bridge-nf-call-iptables net.ipv4.ip_forward
echo -e "\e[1;32m[DONE] s01-prep\e[0m"
