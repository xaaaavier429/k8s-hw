# 共用函式
set -e
cd "$(dirname "${BASH_SOURCE[1]:-$0}")"
. ./config
step() { echo; echo -e "\e[1;36m==> $*\e[0m"; }
# 找出「僅限主機」網卡 (192.168.56.x) 的介面名稱與 IP
HOSTIF=$(ip -o -4 addr show | awk '$4 ~ /^192\.168\.56\./ {print $2; exit}')
HOSTIP=$(ip -o -4 addr show | awk '$4 ~ /^192\.168\.56\./ {split($4,a,"/"); print a[1]; exit}')
